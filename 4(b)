b.	To find the factorial of a number [5]
#include <stdio.h>

long long fact(int n) {
    if (n == 0 || n == 1)
        return 1;
    return n * fact(n - 1);
}

int main() {
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Factorial is not defined for negative numbers\n");
        return 0;
    }

    printf("%d! = %lld\n", n, fact(n));
    return 0;
}
