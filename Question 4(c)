#include <stdio.h>


int fib(int n) {
    if (n == 0)
        return 0;
    if (n == 1)
        return 1;
    return fib(n - 1) + fib(n - 2);
}

int main() {
    int n;
    printf("Which term do you want? ");
    scanf("%d", &n);

    printf("Term number %d of the Fibonacci series is %d\n", n, fib(n));
    return 0;
}
